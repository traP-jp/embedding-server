# Modal deploy settings
# GPU 種別（T4 / A10 など）。deploy 時の function に反映される。
MODAL_GPU=T4
# 同時に動く modalの worker コンテナ数の上限。
MODAL_MAX_CONTAINERS=1
# 1 回の起動で処理する最大ジョブ数。0 = キューが空になるまで（上限なし）。
MODAL_MAX_JOBS_PER_RUN=0
# 定期ポーリング間隔（分）。mise run modal-deploy（MODAL_ENABLE_SCHEDULE=1）時のみ使用。
MODAL_POLL_MINUTES=1
# 1 回の起動のソフトな時間上限（秒）。0 = なし（Modal function timeout までドレイン）。
MODAL_WORKER_RUN_SECONDS=0
# process_queue の Modal function timeout（秒）。deploy 時に反映。既定 3h。
MODAL_FUNCTION_TIMEOUT_SECONDS=10800
# GPU worker の warm 維持秒数。deploy 時に反映。
MODAL_SCALEDOWN_WINDOW_SECONDS=30
# Go から run_batch を POST するときのトークン（query ?token=）。Modal Secret と Go の両方に同じ値を入れる。
MODAL_TRIGGER_TOKEN=replace-me

# Worker API
# host = API_HOST/API_PORT、url = API_BASE_URL を使う。Modal では url。
WORKER_API_MODE=url
# Modal から到達できる公開 HTTPS の Go API ベース URL。
API_BASE_URL=https://embedding-api.example.com

# Object3/S3 compatible job image storage
S3_ENDPOINT_URL=https://object3-endpoint.example.com
S3_BUCKET=embedding-jobs
S3_REGION=auto
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# Worker runtime
# 注意機構。sdpa が無難 flash-attnだと部室サーバーで動かなかったりT4で動かなかったりする。
ATTN_IMPLEMENTATION=sdpa
# キュー空のときの claim 間隔（秒）。Modal は空なら即終了するのでほぼ未使用。
POLL_INTERVAL_SECONDS=0.1
# true だとモデルを載せずダミーベクトルを返す（課金・動作確認用）。
EMBEDDING_WORKER_FAKE=false
# FAKE 時のベクトル次元。
FAKE_EMBEDDING_DIM=1024
# モデル配置。gpu / auto など。
MODEL_DEVICE_MAP=gpu
MODEL_MAX_MEMORY_CUDA=20GiB
MODEL_MAX_MEMORY_CPU=24GiB
# 1 画像あたりの最大ピクセル数（リサイズ上限）。1048576 = 1024x1024 相当。
EMBEDDING_MAX_PIXELS=1048576
# 推論バッチサイズ。画像ジョブ向け。VRAM に合わせて調整（A10 なら 4〜8 目安）。
EMBEDDING_BATCH_SIZE=4
TORCH_DTYPE=bfloat16
# 量子化。none / 4bit など。
QUANTIZATION=4bit
BNB_4BIT_QUANT_TYPE=nf4
BNB_4BIT_USE_DOUBLE_QUANT=true
BNB_4BIT_COMPUTE_DTYPE=bfloat16

# OCR
OCR_ENABLED=false
OCR_DEVICE=cuda
# 認識前の拡大倍率。
OCR_SCALE=2
# 認識・検出の信頼度しきい値（低いほど拾いやすい）。
OCR_REC_THRESHOLD=0.2
OCR_DET_THRESHOLD=0.2
# OCR 結果を埋め込み入力に載せる最大文字数。
OCR_MAX_CHARS=256
# true だとデバッグ用可視化を出す（本番は false）。
OCR_VISUALIZE=false
