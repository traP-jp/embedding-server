# Modal deploy settings
MODAL_GPU=A10
MODAL_MAX_CONTAINERS=1
MODAL_MAX_JOBS_PER_RUN=30
MODAL_POLL_MINUTES=1
MODAL_WORKER_RUN_SECONDS=300
MODAL_IDLE_POLL_SECONDS=2

# Worker API
WORKER_API_MODE=url
API_BASE_URL=https://embedding-api.example.com

# Object3/S3 compatible job image storage
S3_ENDPOINT_URL=https://object3-endpoint.example.com
S3_BUCKET=embedding-jobs
S3_REGION=auto
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# Worker runtime
ATTN_IMPLEMENTATION=sdpa
POLL_INTERVAL_SECONDS=1
EMBEDDING_WORKER_FAKE=false
FAKE_EMBEDDING_DIM=1024
MODEL_DEVICE_MAP=gpu
MODEL_MAX_MEMORY_CUDA=20GiB
MODEL_MAX_MEMORY_CPU=24GiB
EMBEDDING_MAX_PIXELS=1048576
# 画像ジョブ向け。VRAM と枚数に合わせて調整（A10 なら 4〜8 目安）。
EMBEDDING_BATCH_SIZE=4
TORCH_DTYPE=bfloat16
QUANTIZATION=4bit
BNB_4BIT_QUANT_TYPE=nf4
BNB_4BIT_USE_DOUBLE_QUANT=true
BNB_4BIT_COMPUTE_DTYPE=bfloat16

# OCR
OCR_ENABLED=false
OCR_DEVICE=cuda
OCR_SCALE=2
OCR_REC_THRESHOLD=0.2
OCR_DET_THRESHOLD=0.2
OCR_MAX_CHARS=256
OCR_VISUALIZE=false
